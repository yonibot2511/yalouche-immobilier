# =============================================================================
# .env.example — Template public des variables d'environnement
# =============================================================================
#
# Copie ce fichier en ".env" et remplis les valeurs réelles.
# Ce fichier, lui, peut être commité : il ne contient aucune vraie clé.
# =============================================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Google (APIs génériques : Sheets, Drive, Calendar, etc.) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# --- YouTube Data API ---
YOUTUBE_API_KEY=

# --- Vercel ---
VERCEL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
